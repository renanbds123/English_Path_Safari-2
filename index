      <div style="margin-top:6px;text-align:center">
        <button class="${state.studied.includes(x.en)?'':'primary'}" onclick="markStudied(${JSON.stringify(x.en)})" style="width:100%;font-size:11px;padding:4px">${state.studied.includes(x.en)?"Memorizada ✓":"Memorizar"}</button>
