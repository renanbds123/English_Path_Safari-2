function speakText(t,customRate){
  if(!t||!t.trim())return;
  if(!("speechSynthesis" in window)){
    alert("Seu navegador não suporta síntese de voz.");
    return;
  }
  speechSynthesis.cancel();
  let u=new SpeechSynthesisUtterance(t);
  u.lang="en-US";
  const voices=speechSynthesis.getVoices();
  
  let profile = state.speakerVoice || "adult_female";
  let enVoices = voices.filter(v=>v.lang.startsWith("en"));
  
  if(enVoices.length > 0){
    if(profile === "young_female"){
      u.pitch = 1.3;
      u.rate = 1.05;
    } else if(profile === "young_male"){
      u.pitch = 1.0;
      u.rate = 1.05;
    } else if(profile === "adult_male"){
      u.pitch = 0.7;
      u.rate = 0.95;
    } else {
      u.pitch = 1.0;
      u.rate = 0.95;
    }
  }

  let selRate = 0.9;
  if($("speechRateSelect")) selRate = parseFloat($("speechRateSelect").value);
  u.rate = customRate !== undefined ? customRate : (selRate || u.rate);
  
  speechSynthesis.speak(u);
}
if("speechSynthesis" in window){speechSynthesis.onvoiceschanged=()=>speechSynthesis.getVoices();}

