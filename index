function renderWords(){
  let q=normalize($("wordSearch").value||"");
  let f=$("wordFilter").value;
  let cat=$("vocabCategoryFilter").value;
  let words=seed.filter(x=>{
    let matchesQ=normalize(x.en+" "+x.pt+" "+x.phonetic).includes(q);
    let matchesCat=(cat==="all"||x.cat===cat);
    let matchesF=(f==="all"||(f==="new"&&!state.studied.includes(x.en))||(f==="studied"&&state.studied.includes(x.en)));
    return matchesQ && matchesCat && matchesF;
  });
  $("wordList").innerHTML=words.map(x=>`
    <div class="vocab-item" style="text-align:left;position:relative">
      <div style="font-size:32px;text-align:center;margin-bottom:4px">${x.emoji||'📖'}</div>
