<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0b1220">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="English Path 12 Semanas">
<title>English Path — Curso Completo 12 Semanas & Imersão Nativa</title>
<style>
:root{--bg:#0b1220;--panel:#131f32;--panel2:#192941;--text:#edf4ff;--muted:#9fb0c8;--line:#2a3b55;--blue:#69a7ff;--green:#4bd49b;--red:#ff7272;--yellow:#ffd166;--purple:#a78bfa}
*{box-sizing:border-box}body{margin:0;background:linear-gradient(135deg,#0b1220,#101d31);color:var(--text);font:15px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
header{padding:18px max(18px,calc((100% - 1200px)/2));border-bottom:1px solid var(--line);background:#0b1220f2;position:sticky;top:0;z-index:10;backdrop-filter:blur(12px);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px}
h1{font-size:20px;margin:0;display:flex;align-items:center;gap:8px}header p{margin:2px 0 0;color:var(--muted);font-size:12px}
main{max-width:1200px;margin:auto;padding:20px 16px 70px}.tabs{display:flex;gap:8px;overflow:auto;padding:4px 0 14px}
button,.tab{-webkit-appearance:none;appearance:none;touch-action:manipulation;border:1px solid var(--line);background:var(--panel2);color:var(--text);padding:10px 14px;border-radius:11px;cursor:pointer;font-weight:600;transition:0.15s}
button:hover,.tab.active{border-color:var(--blue);background:#203b60}.tab{white-space:nowrap}
.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:14px}.card{background:linear-gradient(160deg,var(--panel),#111c2d);border:1px solid var(--line);border-radius:16px;padding:18px;min-width:0}.span3{grid-column:span 3}.span4{grid-column:span 4}.span6{grid-column:span 6}.span8{grid-column:span 8}.span12{grid-column:span 12}
.metric{font-size:26px;font-weight:800}.muted{color:var(--muted)}.small{font-size:12px;color:var(--muted)}h2{font-size:18px;margin:0 0 12px}h3{font-size:15px;margin:0 0 8px}h4{font-size:13px;margin:10px 0 6px;color:var(--blue)}
.progress{height:9px;border-radius:9px;background:#26364d;overflow:hidden;margin:8px 0}.progress span{display:block;height:100%;background:linear-gradient(90deg,#4c8fff,#4bd49b);width:0;transition:width 0.3s}
input,textarea,select{width:100%;background:#0c1728;border:1px solid var(--line);border-radius:10px;color:var(--text);padding:11px;font:inherit;margin:5px 0 10px}
textarea{min-height:90px;resize:vertical}.primary{background:#2763a9;border-color:#4b8fdf}.good{color:var(--green)}.bad{color:var(--red)}.warn{color:var(--yellow)}.purple{color:var(--purple)}
.row{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.row>*{flex:1}.row button,.row select{flex:0 0 auto}
.lesson{padding:12px;border:1px solid var(--line);border-radius:12px;margin:8px 0;display:flex;justify-content:space-between;gap:10px;align-items:center}
.pill{font-size:11px;border:1px solid var(--line);padding:3px 9px;border-radius:30px;color:var(--muted);background:#192941}
.word-card-big{background:#0c1728;border:1px solid var(--line);border-radius:14px;padding:20px;text-align:center;margin:12px 0}
.emoji-lg{font-size:48px;margin-bottom:8px}
.answer{background:#0c1728;border:1px dashed #405777;padding:14px;border-radius:12px;margin:12px 0}
.hidden{display:none!important}.feedback{padding:10px;border-radius:10px;margin-top:10px;font-size:14px}.feedback.ok{background:#123a31;color:#a7f4d3;border:1px solid #246858}.feedback.no{background:#451f2a;color:#ffc1c1;border:1px solid #783347}
table{width:100%;border-collapse:collapse;font-size:13px}td,th{text-align:left;padding:9px;border-bottom:1px solid var(--line)}.scroll{overflow:auto}
.lesson-box{background:#111d30;border:1px solid var(--line);border-radius:12px;padding:14px;margin:12px 0}
.vocab-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;margin:10px 0}
.vocab-item{background:#192941;border:1px solid var(--line);border-radius:10px;padding:10px;text-align:center}
.ex-item{background:#0f1929;border:1px solid var(--line);padding:12px;border-radius:10px;margin:10px 0}
.opt-btn{display:block;width:100%;text-align:left;margin:5px 0;padding:10px 12px;font-weight:500}
.opt-btn.selected{border-color:var(--blue);background:#203b60}
.diff-ok{color:var(--green);font-weight:700}.diff-no{color:var(--red);text-decoration:underline;font-weight:700}
footer{text-align:center;color:var(--muted);font-size:12px;margin-top:28px}
@media(max-width:760px){.span3,.span4,.span6,.span8{grid-column:span 12}.metric{font-size:22px}header{position:static}}
</style>
</head>
<body>
<header>
  <div>
    <h1>English Path <span class="pill">12 Semanas (Completo)</span></h1>
    <p>Imersão nativa com vozes de jovens/adultos, fonética figurada e treino estilo Duolingo.</p>
  </div>
  <div class="row" style="gap:6px">
    <select id="globalLevel" onchange="changeLevel(this.value)" style="width:auto;margin:0;padding:6px 10px;font-size:12px">
      <option value="beginner">Nível: Iniciante (A1)</option>
      <option value="intermediate" selected>Nível: Intermediário (B1-B2)</option>
      <option value="advanced">Nível: Avançado / Nativo (C1)</option>
    </select>
  </div>
</header>
<main>
<nav class="tabs" id="tabs">
  <button class="tab active" data-page="painel">Painel</button>
  <button class="tab" data-page="curso">Curso 12 Semanas</button>
  <button class="tab" data-page="escuta">Escuta & Áudio Nativo</button>
  <button class="tab" data-page="vocabulario">Vocabulário & Memória</button>
  <button class="tab" data-page="flashcards">Flashcards Visuais</button>
  <button class="tab" data-page="pratica">Prática & Duolingo</button>
  <button class="tab" data-page="historico">Histórico</button>
</nav>

<section id="painel" class="page">
<div class="grid">
  <div class="card span3"><div class="muted">Semanas / Aulas Feitas</div><div class="metric" id="mDays">0/84</div><div class="progress"><span id="pDays"></span></div></div>
  <div class="card span3"><div class="muted">Taxa de Acertos</div><div class="metric" id="mAccuracy">0%</div><div class="small" id="mCounts">0 acertos · 0 erros</div></div>
  <div class="card span3"><div class="muted">Palavras Memorizadas</div><div class="metric" id="mWords">0</div><div class="small">Vocabulário estudado com imagens</div></div>
  <div class="card span3"><div class="muted">Tempo de Prática</div><div class="metric" id="mTime">0 min</div><div class="small">Sessões de imersão concluídas</div></div>

  <div class="card span8">
    <h2>Trilha de 12 Semanas & Imersão Real</h2>
    <p class="muted" id="dailyMessage">Bem-vindo ao English Path Completo. Escolha sua sessão diária (10, 15 ou 30 min) e mergulhe no inglês real de jovens e adultos nativos[span_1](start_span)[span_1](end_span).</p>
    <div class="row" style="margin:12px 0">
      <div>
        <label class="small"><b>Duração da Sessão de Estudo:</b></label>
        <select id="sessionTime" onchange="setSessionDuration(this.value)">
          <option value="10">Sessão Rápida (10 minutos)</option>
          <option value="15">Sessão Padrão (15 minutos)</option>
          <option value="30" selected>Sessão Completa (30 minutos)</option>
        </select>
      </div>
      <div>
        <label class="small"><b>Modo de Avanço:</b></label>
        <button class="primary" onclick="go('curso')">Ir para a Semana Atual</button>
      </div>
    </div>
    <div class="progress"><span id="pOverall"></span></div>
    <div class="small" id="overallText">0% do curso completo concluído</div>
  </div>

  <div class="card span4">
    <h2>Sessão Diária Ativa</h2>
    <div id="timerBox" class="answer" style="text-align:center">
      <div class="small">Tempo restante na sessão</div>
      <div class="metric" id="timerDisplay">30:00</div>
      <div class="row" style="margin-top:10px">
        <button class="primary" onclick="startTimer()">Iniciar Timer</button>
        <button onclick="pauseTimer()">Pausar</button>
      </div>
    </div>
  </div>

  <div class="card span12">
    <h2>Seleção de Locutor Nativo (Jovem / Adulto)</h2>
    <p>Escolha qual voz nativa deseja ouvir nas aulas e nos treinos de escuta. O sistema utiliza vozes em inglês do seu dispositivo com ajustes de tom para simular diferentes perfis (jovem dinâmico ou adulto experiente)[span_2](start_span)[span_2](end_span).</p>
    <div class="row">
      <div>
        <label class="small"><b>Perfil de Locução:</b></label>
        <select id="speakerVoice" onchange="updateVoiceProfile(this.value)">
          <option value="young_female">Jovem (Feminina - Tom Ágil)</option>
          <option value="young_male">Jovem (Masculina - Tom Dinâmico)</option>
          <option value="adult_female" selected>Adulto (Feminina - Tom Natural)</option>
          <option value="adult_male">Adulto (Masculina - Tom Profundo)</option>
        </select>
      </div>
      <div>
        <label class="small"><b>Gerenciamento de Dados:</b></label>
        <div class="row">
          <button onclick="exportData()">Exportar JSON</button>
          <button onclick="document.getElementById('importBackup').click()">Restaurar Backup</button>
          <input id="importBackup" type="file" accept=".json" class="hidden" onchange="importBackup(event)">
          <button class="warn" onclick="resetProgress()">Reiniciar</button>
        </div>
      </div>
    </div>
  </div>
</div>
</section>

<section id="curso" class="page hidden">
<div class="card">
  <h2>Trilha Completa — 12 Semanas (84 Dias de Imersão)</h2>
  <p class="muted">Navegue por semanas e dias livremente. Cada aula traz vocabulário visual, fonética aportuguesada, gramática, diálogos com vozes nativas e exercícios de fixação[span_3](start_span)[span_3](end_span).</p>
  <div class="row" style="margin-bottom:12px">
    <select id="weekFilter" onchange="renderLessons()"></select>
  </div>
  <div id="lessonList"></div>
  <div id="lessonDetail" class="answer hidden"></div>
</div>
</section>

<section id="escuta" class="page hidden">
<div class="grid">
  <div class="card span8">
    <h2>Escuta Nativa (Jovens e Adultos) & Redução de Sons</h2>
    <p class="muted">Treine com frases reais. Ouça com o locutor selecionado, controle a velocidade (0.6x a 1.0x) e digite exatamente o que ouviu[span_4](start_span)[span_4](end_span).</p>
    <div class="row">
      <div><span class="pill" id="listenCount">Rodada 0/10</span></div>
      <select id="speechRateSelect" title="Velocidade">
        <option value="0.6">Super Lenta (0.6x)</option>
        <option value="0.8">Lenta / Prática (0.8x)</option>
        <option value="1.0" selected>Velocidade Nativa (1.0x)</option>
      </select>
      <button class="primary" onclick="startListening()">Nova Rodada Nativa</button>
    </div>
    <div id="listenArea" class="answer hidden">
      <div class="small">Áudio <span id="listenIndex">1</span> de 10</div>
      <div class="row" style="margin-top:8px">
        <button class="primary" onclick="speakCurrentAudio()">🔊 Ouvir com Locutor Selecionado</button>
        <button onclick="speakCurrentAudio(0.5)">🐢 Ouvir Devagar</button>
      </div>
      <label for="transcript" style="display:block;margin-top:10px"><b>Escreva exatamente o que escutou em inglês</b></label>
      <input id="transcript" autocomplete="off" placeholder="Digite aqui..." onkeydown="if(event.key==='Enter')checkListening()">
      <div class="row"><button class="primary" onclick="checkListening()">Verificar Resposta</button><button onclick="nextListening()">Pular / Próximo</button></div>
      <div id="listenFeedback"></div>
    </div>
    <div id="listenEmpty" class="answer">Clique em "Nova Rodada Nativa" para iniciar o treino de escuta auditiva.</div>
  </div>
  <div class="card span4">
    <h2>Dicas de Inglês Falado</h2>
    <div class="small" style="line-height:1.6">
      <p><b>Inglês Nativo Real:</b></p>
      <p>• <i>Want to</i> ➔ <b>wanna</b></p>
      <p>• <i>Going to</i> ➔ <b>gonna</b></p>
      <p>• <i>Don't you</i> ➔ <b>doncha</b></p>
      <p>• <i>What do you</i> ➔ <b>whatcha</b></p>
      <p class="muted">Nossos áudios simulam conversas reais entre jovens e adultos no exterior[span_5](start_span)[span_5](end_span).</p>
    </div>
  </div>
</div>
</section>

<section id="vocabulario" class="page hidden">
<div class="card">
  <h2>Banco de Vocabulário & Memorização Visual</h2>
  <p class="muted">Busque palavras por tema (Casa, Restaurante, Saudações, Negócios) e confira a fonética figurada (ex: <i>Table = téibou</i>)[span_6](start_span)[span_6](end_span).</p>
  <input id="wordSearch" placeholder="Pesquisar palavra em inglês ou português..." oninput="renderWords()">
  <div class="row">
    <select id="vocabCategoryFilter" onchange="renderWords()">
      <option value="all">Todas as Categorias</option>
      <option value="Greetings">Saudações & Contatos</option>
      <option value="Restaurant">Restaurante & Comida</option>
      <option value="House">Coisas da Casa & Cômodos</option>
      <option value="Daily">Rotina & Vida Diária</option>
      <option value="Native">Expressões Nativas & Reduções</option>
    </select>
    <select id="wordFilter" onchange="renderWords()">
      <option value="all">Todos os Status</option>
      <option value="new">Não estudadas</option>
      <option value="studied">Memorizadas</option>
    </select>
    <button onclick="document.getElementById('importWords').click()">Importar JSON</button>
    <input id="importWords" type="file" accept=".json" class="hidden" onchange="importWords(event)">
  </div>
  <div id="wordList" class="vocab-grid"></div>
</div>
</section>

<section id="flashcards" class="page hidden">
<div class="card" style="text-align:center">
  <h2>Flashcards com Associação Visual & Fonética</h2>
  <p class="muted">Visualize a imagem/emoji, ouça o locutor nativo e tente lembrar o significado.</p>
  <div class="word-card-big" id="flashCardBox">
    <div class="emoji-lg" id="flashEmoji">🏠</div>
    <div class="small" id="flashProgress">Cartão 1 de 100</div>
    <div class="word" id="flashWord" style="margin:8px 0">House</div>
    <div class="small purple" id="flashPhonetic">Pronúncia: ráus</div>
    <div id="flashTranslation" class="hidden good" style="font-size:20px;margin-top:10px;font-weight:700">Casa</div>
  </div>
  <div class="row" style="justify-content:center;margin-top:14px">
    <button class="primary" onclick="speakText($('flashWord').textContent)">🔊 Ouvir Locutor</button>
    <button class="primary" onclick="revealFlash()">Revelar Tradução</button>
    <button onclick="flashRate(true)">Eu Sabia ✓</button>
    <button onclick="flashRate(false)">Revisar</button>
    <button onclick="nextFlash()">Próximo ➔</button>
  </div>
</div>
</section>

<section id="pratica" class="page hidden">
<div class="grid">
  <div class="card span6">
    <h2>Prática Estilo Duolingo (Formação de Frases)</h2>
    <p class="small text-muted">Monte a frase correta em inglês selecionando ou escrevendo com base no vocabulário estudado.</p>
    <div id="duoQuizArea" class="answer">
      <div class="small" id="duoStep">Exercício 1 de 5</div>
      <div id="duoPrompt" style="font-size:16px;font-weight:700;margin:10px 0">Traduza: "Eu gostaria de um copo de água, por favor."</div>
      <div id="duoOptions" class="row" style="margin:10px 0"></div>
      <input id="duoInput" placeholder="Digite sua resposta em inglês..." autocomplete="off">
      <button class="primary" onclick="checkDuoAnswer()">Verificar</button>
      <div id="duoFeedback"></div>
    </div>
  </div>

  <div class="card span6">
    <h2>Leitura Imersiva & Compreensão</h2>
    <div class="row">
      <select id="readingSelect" onchange="loadReading()"></select>
      <button onclick="speakText($('readingText').innerText)">🔊 Ouvir Texto</button>
    </div>
    <h3 id="readingTitle" style="margin-top:10px"></h3>
    <p id="readingText" style="line-height:1.6"></p>
    <p class="muted small" id="readingHint"></p>
    <label id="readingQuestionLabel"><b>Pergunta:</b></label>
    <input id="readingAnswer" placeholder="Escreva sua resposta em inglês..." autocomplete="off" onkeydown="if(event.key==='Enter')checkReading()">
    <button class="primary" onclick="checkReading()">Verificar Resposta</button>
    <div id="readingFeedback"></div>
  </div>

  <div class="card span12">
    <h2>Treino de Pronúncia & Reconhecimento de Fala</h2>
    <p class="muted">Ouça a frase com o locutor, clique no microfone e repita em voz alta para comparar.</p>
    <div class="word" id="dialogueLine" style="font-size:22px;margin:10px 0">I'd like a table for two, please.</div>
    <div class="small purple" id="dialoguePhonetic">Pronúncia figurada: áid láik ê téibou fór tú, plíz</div>
    <div class="row">
      <button class="primary" onclick="speakText($('dialogueLine').innerText)">🔊 Ouvir Frase</button>
      <button onclick="nextDialogue()">Próxima Frase</button>
      <button class="primary" onclick="recognizeSpeech()">🎙️ Falar no Microfone</button>
    </div>
    <div id="speechResult" class="answer small">Clique no botão de microfone e repita a frase em inglês.</div>
  </div>
</div>
</section>

<section id="historico" class="page hidden">
<div class="card">
  <h2>Histórico de Desempenho</h2>
  <div class="row">
    <div class="metric" id="historyTotal">0</div>
    <div><span class="good" id="historyCorrect">0 acertos</span><br><span class="bad" id="historyWrong">0 erros</span></div>
    <button onclick="clearHistory()">Limpar Histórico</button>
  </div>
  <div class="scroll">
    <table>
      <thead><tr><th>Data/Hora</th><th>Tipo</th><th>Exercício</th><th>Sua Resposta</th><th>Resposta Correta</th><th>Status</th></tr></thead>
      <tbody id="historyRows"></tbody>
    </table>
  </div>
</div>
</section>

<footer>English Path 12 Semanas · Vozes de Jovens e Adultos · Salvo localmente no dispositivo[span_7](start_span)[span_7](end_span).</footer>
</main>

<script>
const $=id=>document.getElementById(id);

const baseVocab=[
