function normalize(s){
  return String(s).toLowerCase().trim()
    .replace(/’/g,"'")
    .replace(/ i'm /g,"i am").replace(/ you're /g,"you are").replace(/ he's /g,"he is")
    .replace(/ she's /g,"she is").replace(/ it's /g,"it is").replace(/ we're /g,"we are")
    .replace(/ they're /g,"they are").replace(/ don't /g,"do not").replace(/ doesn't /g,"does not")
    .replace(/[.,!?;:'"“”]/g,"")
    .replace(/\s+/g," ");
}

function buildDiffHtml(userStr,correctStr){
  const uWords=normalize(userStr).split(" ").filter(Boolean);
  const cWords=correctStr.split(" ");
  return cWords.map((cw,idx)=>{
    const cleanC=normalize(cw);
    const matched=uWords[idx]===cleanC || uWords.includes(cleanC);
    return `<span class="${matched?'diff-ok':'diff-no'}">${escapeHtml(cw)}</span>`;
  }).join(" ");
}

function checkListening(){
