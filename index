  const ok=r.accepted.some(acc=>a.includes(normalize(acc))||normalize(acc)===a);
  $("readingFeedback").innerHTML=ok
    ?`<div class="feedback ok"><b>Excelente!</b> Resposta correta.<br>Modelo: <i>${r.sample}</i></div>`
    :`<div class="feedback no"><b>Revise o texto:</b> Resposta esperada: <i>${r.sample}</i></div>`;
  record("Leitura",r.title,raw,r.sample,ok,10);
}

const dialogues=[
  {en:"I'd like a table for two, please.",phon:"áid láik ê téibou fór tú, plíz"},
  {en:"Where is the nearest coffee shop?",phon:"uér ís thê níarest cófi shóp?"},
  {en:"What are you gonna do tonight?",phon:"uót ár iu góna dú tunáit?"},
  {en:"Could you speak more slowly, please?",phon:"cúd iu spík mór slóuli, plíz?"}
];
let dIdx=0;
function nextDialogue(){
  dIdx=(dIdx+1)%dialogues.length;
  $("dialogueLine").textContent=dialogues[dIdx].en;
  $("dialoguePhonetic").textContent=`Pronúncia figurada: ${dialogues[dIdx].phon}`;
}
function recognizeSpeech(){
  let SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  if(!SR){
    $("speechResult").textContent="Reconhecimento de fala não disponível neste navegador.";
    return;
  }
  let rec=new SR();
  rec.lang="en-US";
  rec.interimResults=false;
  $("speechResult").textContent="🎙️ Ouvindo... Fale a frase em inglês agora.";
  rec.onresult=e=>{
    const spoken=e.results[0][0].transcript;
    const target=dialogues[dIdx].en;
    const ok=normalize(spoken)===normalize(target);
    $("speechResult").innerHTML=ok
      ?`<span class="good"><b>Excelente pronúncia!</b> Você disse: "${escapeHtml(spoken)}"</span>`
      :`Você disse: <b>"${escapeHtml(spoken)}"</b><br>Comparação: ${buildDiffHtml(spoken,target)}`;
  };
  rec.onerror=()=>$("speechResult").textContent="Não foi possível reconhecer. Verifique o microfone.";
  rec.start();
}

function renderHistory(){
  let c=state.history.filter(x=>x.ok).length,w=state.history.length-c;
  $("historyTotal").textContent=state.history.length;
  $("historyCorrect").textContent=`${c} acertos`;
  $("historyWrong").textContent=`${w} erros`;
  $("historyRows").innerHTML=state.history.map(x=>`
    <tr>
      <td>${escapeHtml(x.time)}</td>
      <td>${escapeHtml(x.type)}</td>
      <td>${escapeHtml(x.item)}</td>
      <td>${escapeHtml(x.user)}</td>
      <td>${escapeHtml(x.correct)}</td>
      <td class="${x.ok?"good":"bad"}">${x.ok?"Acerto":"Erro"}</td>
    </tr>
  `).join("");
}

function escapeHtml(s){
  return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}

function clearHistory(){
  if(confirm("Apagar todo o histórico?")){
    state.history=[];
    state.due=[];
    save();
    renderHistory();
  }
}

function resetProgress(){
  if(confirm("Deseja reiniciar todo o progresso do curso?")){
    localStorage.removeItem("englishPath12Weeks");
    location.reload();
  }
}

function exportData(){
  let blob=new Blob([JSON.stringify({state,seed},null,2)],{type:"application/json"});
  let a=document.createElement("a");
  a.href=URL.createObjectURL(blob);
  a.download="english-path-12semanas-backup.json";
  a.click();
  URL.revokeObjectURL(a.href);
}

function importBackup(ev){
  let file=ev.target.files[0];
  if(!file)return;
  let r=new FileReader();
  r.onload=()=>{
    try{
      let parsed=JSON.parse(r.result);
      if(!parsed.state)throw 0;
      state=Object.assign({done:[],history:[],studied:[],ratings:{},due:[],writing:[],customWords:[],level:"intermediate",sessionTime:30,speakerVoice:"adult_female"},parsed.state);
      if(Array.isArray(parsed.seed)){
        parsed.seed.forEach(w=>{if(!seed.some(x=>normalize(x.en)===normalize(w.en)))seed.push(w);});
      }
      save();
      renderLessons();
      renderWords();
      alert("Backup restaurado com sucesso!");
    }catch(e){
      alert("Arquivo de backup inválido.");
    }
  };
  r.readAsText(file);
}

updateDashboard();
renderLessons();
renderWords();
showFlash();
initReadings();
initDuoQuiz();
updateTimerDisplay();
</script>
