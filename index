function importWords(ev){
  let file=ev.target.files[0];
  if(!file)return;
  let r=new FileReader();
  r.onload=()=>{
    try{
      let arr=JSON.parse(r.result);
      if(!Array.isArray(arr))throw 0;
      let added=0;
      arr.forEach(x=>{
        if(x.en && x.pt){
          const item={en:String(x.en).trim(),pt:String(x.pt).trim(),phonetic:x.phonetic||x.en,emoji:x.emoji||'📚',cat:x.cat||'Daily'};
          if(!seed.some(y=>normalize(y.en)===normalize(item.en))){
            seed.push(item);
            state.customWords.push(item);
            added++;
          }
        }
      });
      save();
      alert(`${added} palavras importadas com sucesso!`);
      renderWords();
    }catch(e){
      alert("Arquivo JSON inválido.");
    }
  };
  r.readAsText(file);
}

